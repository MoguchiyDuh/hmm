IMAGE_PREFIX=ghcr.io/example/hmm
IMAGE_TAG=latest
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
DOMAIN=hmm.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PASSWORD=replace-with-random-password
PUBLIC_URL=https://hmm.example.com
DATABASE_URL=postgresql+psycopg://hmm:replace-with-random-password@postgres:5432/hmm
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-random-secret
S3_BUCKET=hmm
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
SESSION_SECRET=replace-with-random-secret
ADMIN_GITHUB_LOGINS=
BOT_SERVICE_TOKEN=
TELEGRAM_BOT_USERNAME=
PARSER_SERVICE_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
CORE_URL=http://api:8000
BOT_TOKEN=
PARSER_DATABASE_URL=postgresql+psycopg://hmm:replace-with-random-password@postgres:5432/hmm_parser
LOG_LEVEL=INFO
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=example-backups
BACKUP_S3_ACCESS_KEY=replace-with-backup-access-key
BACKUP_S3_SECRET_KEY=replace-with-backup-secret
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=hmm
BACKUP_SCHEDULE='0 3 * * *'
BACKUP_TIMEZONE=UTC
BACKUP_RETENTION_DAYS=30
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
POSTGRES_MEMORY=512m
POSTGRES_CPUS=1.0
MINIO_MEMORY=512m
MINIO_CPUS=1.0
INIT_MEMORY=128m
INIT_CPUS=0.5
MIGRATE_MEMORY=256m
MIGRATE_CPUS=1.0
API_MEMORY=512m
API_CPUS=1.0
WORKER_MEMORY=512m
WORKER_CPUS=1.0
BOT_MEMORY=256m
BOT_CPUS=0.5
PARSER_MEMORY=256m
PARSER_CPUS=0.5
WEB_MEMORY=128m
WEB_CPUS=0.5
BACKUP_MEMORY=256m
BACKUP_CPUS=0.5
