{
  "components": {
    "schemas": {
      "AreaId": {
        "format": "uuid",
        "type": "string"
      },
      "AreaKey": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "AreaResponse": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "title": "Allowed Actions",
            "type": "array"
          },
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/AreaId"
          },
          "key": {
            "$ref": "#/components/schemas/AreaKey"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sort": {
            "title": "Sort",
            "type": "integer"
          }
        },
        "required": [
          "allowed_actions",
          "key",
          "name",
          "id",
          "description",
          "sort",
          "archived_at"
        ],
        "title": "AreaResponse",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "already_enrolled",
          "already_in_team",
          "already_invited",
          "attendance_window_closed",
          "bad_request",
          "banned",
          "cannot_confirm_own_fact",
          "checkin_limit",
          "code_expired",
          "code_invalid",
          "confirmation_withdraw_closed",
          "core_full",
          "enrollment_closed",
          "file_too_large",
          "forbidden",
          "formation_in_progress",
          "help_request_open",
          "internal_error",
          "invalid_state",
          "join_request_pending",
          "last_admin",
          "lead_fit_pending",
          "lead_fit_too_low",
          "lead_not_swappable",
          "mentee_limit_reached",
          "mentor_capacity_reached",
          "merge_too_large",
          "not_draft",
          "not_enrolled",
          "not_found",
          "not_implemented",
          "onboarding_required",
          "origin_mismatch",
          "possible_duplicate",
          "project_full",
          "projects_led_limit",
          "rate_limited",
          "refresh_too_soon",
          "restricted",
          "result_exists",
          "result_not_due",
          "review_window_closed",
          "seats_close_below_min",
          "team_full",
          "telegram_already_linked",
          "telegram_not_linked",
          "unauthenticated",
          "unsupported_file_type",
          "user_dnd",
          "validation_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Errors",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ValidationIssue": {
        "additionalProperties": false,
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BotServiceToken": {
        "scheme": "bearer",
        "type": "http"
      },
      "ParserServiceToken": {
        "scheme": "bearer",
        "type": "http"
      },
      "SessionCookie": {
        "in": "cookie",
        "name": "hmm_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "hmm",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/areas": {
      "get": {
        "operationId": "areas_list_areas",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AreaResponse"
                  },
                  "title": "Response Areas List Areas",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "501": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "summary": "List areas",
        "tags": [
          "areas"
        ]
      }
    }
  }
}
